rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Avatar images belong exclusively to their owner
    //
    // Separate 'delete' from 'write': during deletion,
    // request.resource is null, so a size condition in 'write'
    // would block every deletion.
    match /avatars/{userId}/{allPaths=**} {
      allow read, delete: if request.auth != null
                          && request.auth.uid == userId;
      
      // Strict validation: only JPEG, PNG, WebP allowed
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
                   && !isBlacklisted(request.resource.contentType);
    }
  }
}

function isBlacklisted(contentType) {
  // Prevent SVG and other potentially dangerous formats
  return contentType in ['image/svg+xml', 'image/x-svg', 'application/svg+xml'];
}

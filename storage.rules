rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Regel-Wissensbasis (SPIEL-04): Clients lesen und schreiben hier nie.
    // Die Cloud Function `rulesIndexApi` verteilt kurzlebige URLs, hochgeladen
    // wird von Hand (`dsa-rules-cli publish`). Ohne diese Regel wäre `rules/`
    // zwar ebenfalls gesperrt, aber nur durch das Fehlen einer Freigabe.
    match /rules/{allPaths=**} {
      allow read, write: if false;
    }

    // Avatarbilder gehoeren ausschliesslich ihrem Konto.
    //
    // `delete` steht bewusst getrennt von `write`: Bei einer Loeschung ist
    // `request.resource` null, eine Groessenbedingung in `write` wuerde also
    // jedes Loeschen blockieren.
    match /avatars/{userId}/{allPaths=**} {
      allow read, delete: if request.auth != null
                          && request.auth.token.email_verified == true
                          && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.token.email_verified == true
                   && request.auth.uid == userId
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType in [
                     'image/jpeg',
                     'image/png',
                     'image/webp'
                   ];
    }
  }
}

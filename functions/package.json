{
  "name": "dsa-heldenverwaltung-functions",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/**/*.test.ts",

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Legacy-Gruppen hatten keine belastbare Besitzer- oder Mitgliedsidentität.
    // Die Daten bleiben für eine spätere, administrativ geprüfte Migration
    // erhalten, sind für sämtliche Clients aber vollständig gesperrt.
    match /gruppen/{gruppenCode} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Neue Gruppen verwenden Firebase-UIDs als Identität. Der Beitritt läuft
    // über den `joinCode` im Gruppendokument (nur Mitglieder lesen ihn); die
    // Sammlung `invitations` bleibt für ein späteres Backend reserviert.
    match /groups_v2/{groupId} {
      allow read: if isGroupMember(groupId);
      allow create: if isVerified()
                    && request.resource.data.ownerUid == request.auth.uid
                    && validGroup(request.resource.data);
      allow update: if isGroupOwner(groupId)
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && validGroup(request.resource.data);
      allow delete: if isGroupOwner(groupId);

      match /members/{memberId} {
        allow read: if isGroupMember(groupId);
        // Der Besitzer trägt Mitglieder ein; wer den Beitrittscode kennt,
        // trägt sich selbst als Mitglied ein.
        allow create: if (isGroupOwner(groupId) && validMember(request.resource.data))
                      || canJoinGroup(groupId, memberId);
        allow update: if isGroupOwner(groupId)
                      && validMember(request.resource.data);
        // Mitglieder dürfen gehen; der Besitzer löscht nur die ganze Gruppe.
        allow delete: if isGroupOwner(groupId)
                      || (isVerified()
                          && request.auth.uid == memberId
                          && resource.data.role == 'member');
      }

      match /hero_snapshots/{memberId} {
        allow read: if isGroupMember(groupId);
        allow create, update: if isVerified()
                              && request.auth.uid == memberId
                              && isGroupMember(groupId)
                              && request.resource.size() < 400 * 1024;
        allow delete: if (isGroupMember(groupId) && request.auth.uid == memberId)
                      || isGroupOwner(groupId);
      }

      // Geteilte Gruppeninfos: Alle Mitglieder dürfen gemeinsame Einträge
      // (z. B. NSC-Begleiter) lesen, anlegen, ändern und löschen.
      match /shared_heroes/{entryId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
                      && request.resource.data.createdByUid == request.auth.uid
                      && request.resource.size() < 400 * 1024;
        allow update: if isGroupMember(groupId)
                      && request.resource.data.createdByUid == resource.data.createdByUid
                      && request.resource.size() < 400 * 1024;
        allow delete: if isGroupMember(groupId);
      }

      match /shared_info/{infoId} {
        allow read: if isGroupMember(groupId);
        allow create, update: if (isGroupMember(groupId)
                                  && infoId == 'notizen'
                                  && validNotizen(request.resource.data))
                              || (isGroupOwner(groupId)
                                  && infoId == 'regelprofil'
                                  && validRegelprofil(request.resource.data));
        allow delete: if isGroupOwner(groupId);
      }

      match /invitations/{invitationId} {
        allow read, write: if false;
      }
    }

    // Pro-User-Bereich fuer privaten Helden-Sync.
    // Nur der eingeloggte User darf sein eigenes Subtree lesen/schreiben.
    match /users/{userId} {
      allow read, write: if isVerifiedUser(userId);

      match /heroes/{heroId} {
        allow read, delete: if isVerifiedUser(userId);
        // Schreibgroesse begrenzen (~400 KB pro Held inkl. Avatar-Base64).
        allow create, update: if isVerifiedUser(userId)
                              && request.resource.size() < 500 * 1024;
      }

      match /hero_states/{heroId} {
        allow read, delete: if isVerifiedUser(userId);
        allow create, update: if isVerifiedUser(userId)
                              && request.resource.size() < 200 * 1024;
      }

      // Verschluesselte Settings-Geheimnisse (Katalog-Passwort, API-Key).
      // Dokument ist klein (~1 KB), nur der eigene User darf zugreifen.
      match /private/{document=**} {
        allow read, delete: if isVerifiedUser(userId);
        allow create, update: if isVerifiedUser(userId)
                              && request.resource.size() < 16 * 1024;
      }
    }

    // Alle anderen Pfade blockiert.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn()
             && request.auth.token.email_verified == true;
    }

    function isVerifiedUser(userId) {
      return isVerified()
             && request.auth.uid == userId;
    }

    function isGroupMember(groupId) {
      return isVerified()
             && exists(/databases/$(database)/documents/groups_v2/$(groupId)/members/$(request.auth.uid));
    }

    function isGroupOwner(groupId) {
      return isVerified()
             && get(/databases/$(database)/documents/groups_v2/$(groupId)).data.ownerUid
                == request.auth.uid;
    }

    function validGroup(data) {
      return data.keys().hasAll(['name', 'ownerUid', 'joinCode'])
             && data.keys().hasOnly(['name', 'ownerUid', 'joinCode', 'createdAt', 'updatedAt'])
             && data.name is string
             && data.name.size() > 0
             && data.name.size() <= 100
             && data.ownerUid is string
             && data.ownerUid.size() > 0
             && data.joinCode is string
             && data.joinCode.size() >= 8
             && data.joinCode.size() <= 64;
    }

    // Selbstbeitritt: nur als einfaches Mitglied, nur mit dem Beitrittscode
    // der Gruppe. `get` liest unabhängig von den Leserechten des Clients.
    function canJoinGroup(groupId, memberId) {
      let data = request.resource.data;
      return isVerified()
             && request.auth.uid == memberId
             && data.keys().hasAll(['role', 'joinCode'])
             && data.keys().hasOnly(['role', 'joinedAt', 'joinCode'])
             && data.role == 'member'
             && data.joinCode is string
             && data.joinCode == get(/databases/$(database)/documents/groups_v2/$(groupId)).data.joinCode;
    }

    function validNotizen(data) {
      return data.keys().hasAll(['text'])
             && data.keys().hasOnly(['text', 'updatedByUid', 'updatedAt'])
             && data.text is string
             && data.text.size() <= 20000;
    }

    // Regelprofil-Vorgabe der Gruppe: das Profil liegt als JSON-Text im Feld
    // `profilJson`. Es schreibt nur der Besitzer; alle Mitglieder lesen.
    function validRegelprofil(data) {
      return data.keys().hasAll(['profilJson'])
             && data.keys().hasOnly(['profilJson', 'updatedByUid', 'updatedAt'])
             && data.profilJson is string
             && data.profilJson.size() > 0
             && data.profilJson.size() <= 900000;
    }

    function validMember(data) {
      return data.keys().hasAll(['role'])
             && data.keys().hasOnly(['role', 'joinedAt'])
             && data.role in ['owner', 'member'];
    }
  }
}

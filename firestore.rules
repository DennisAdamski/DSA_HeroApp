rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to validate group code format
    function isValidGroupCode(code) {
      // Require at least 20 alphanumeric characters to prevent brute force
      return code.matches('[a-zA-Z0-9]{20,}');
    }

    // Helper to count user documents (for DoS prevention)
    function countUserDocuments(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.heroCount;
    }

    // Group management - no anonymous access
    match /gruppen/{gruppenCode} {

      // Read: Only authenticated users or those with valid group code
      allow read: if request.auth != null || isValidGroupCode(gruppenCode);

      // Create: Only authenticated users can create groups
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['gruppenName', 'erstelltAm', 'creatorId'])
                    && request.resource.data.gruppenName is string
                    && request.resource.data.gruppenName.size() > 0
                    && request.resource.data.gruppenName.size() <= 100
                    && request.resource.data.creatorId == request.auth.uid;

      // Update/Delete: Only creator can modify
      allow update, delete: if request.auth != null
                            && get(/databases/$(database)/documents/gruppen/$(gruppenCode)).data.creatorId == request.auth.uid;

      // --- Mitglieder-Subcollection ---
      match /mitglieder/{memberId} {

        // Read: Only authenticated group members can read
        allow read: if request.auth != null;

        // Create/Update: Validated member data
        allow create, update: if request.auth != null && validateMitglied();

        // Delete: Only group creator or own deletion
        allow delete: if request.auth != null
                      && (request.auth.uid == get(/databases/$(database)/documents/gruppen/$(gruppenCode)).data.creatorId
                          || request.auth.uid == memberId);
      }
    }

    // Pro-User-Bereich fuer privaten Helden-Sync
    // Nur der eingeloggte User darf sein eigenes Subtree lesen/schreiben
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      match /heroes/{heroId} {
        allow read, delete: if request.auth != null
                            && request.auth.uid == userId;
        // Limit size to prevent DoS (~250 KB per hero)
        allow create, update: if request.auth != null
                              && request.auth.uid == userId
                              && request.resource.size() < 256 * 1024
                              && heroCountLimitNotExceeded(userId);
      }

      match /hero_states/{heroId} {
        allow read, delete: if request.auth != null
                            && request.auth.uid == userId;
        // Limit size to prevent DoS (~100 KB per state)
        allow create, update: if request.auth != null
                              && request.auth.uid == userId
                              && request.resource.size() < 100 * 1024;
      }

      // Encrypted settings secrets (catalog password, API key)
      // Document is small (~1 KB), only own user has access
      match /private/{document=**} {
        allow read, delete: if request.auth != null
                            && request.auth.uid == userId;
        allow create, update: if request.auth != null
                              && request.auth.uid == userId
                              && request.resource.size() < 16 * 1024;
      }
    }

    // Block all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function validateMitglied() {
  let d = request.resource.data;
  return d.keys().hasAll(['heroId', 'name', 'exportedAt'])
      && d.heroId is string
      && d.name is string
      && d.heroId.size() > 0
      && d.heroId.size() <= 100
      && d.name.size() > 0
      && d.name.size() <= 200
      // Limit avatar size (max 200 KB Base64)
      && (!('avatarThumbnailBase64' in d) || d.avatarThumbnailBase64.size() <= 262144)
      // Total document max 300 KB
      && request.resource.size() < 300 * 1024;
}

function heroCountLimitNotExceeded(userId) {
  // Prevent DoS: max 100 heroes per user
  let userDoc = get(/databases/$(database)/documents/users/$(userId));
  return !exists(userDoc) || (userDoc.data.heroCount() < 100);
}
